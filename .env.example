# Copy this file to .env and fill in your values

# API token for https://api.green-coding.io
API_TOKEN=PLEASE_INPUT_YOUR_API_TOKEN

# Manufacturing (embodied) carbon of your machine share in gCO2e
# e.g. from https://datavizta.boavizta.org/serversimpact multiplied by the vhost ratio
SCI_M=PLEASE_INPUT_EMBODIED_CARBON_OF_MACHINE_SHARE_IN_G

# Expected lifetime of the machine in seconds. Default 4 years = 60*60*24*365*4
SCI_USAGE_DURATION=126144000

# Machine power profile generated by Cloud Energy with: python3 xgb.py ... --dump-hashmap > <file>
# Relative paths are resolved against the folder of machine_energy_carbondb.sh
POWER_PROFILE_FILE=hetzner_CAX21.sh
